#!/bin/sh

# Get list of staged files before formatting
STAGED_FILES=$(mktemp) || exit 1
trap 'rm -f "$STAGED_FILES"' 0

git diff --cached --name-only --diff-filter=ACMR -z \
  > "$STAGED_FILES" || exit 1

if [ ! -s "$STAGED_FILES" ]; then
  exit 0
fi

# Run prettier format on frontend
cd frontend && npm run format:fix
cd ..

# Run prettier format on e2e
cd e2e && npm run format:fix
cd ..

# Re-add only the files that were originally staged
xargs -0 git --literal-pathspecs add -- < "$STAGED_FILES"
