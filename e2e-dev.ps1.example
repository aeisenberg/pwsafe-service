# PowerShell script for local e2e development
$ErrorActionPreference = "Stop"

# Configuration - Update these absolute paths for your local environment
$CONFIG_DIR = "C:\some\folder\config" # Path to dev config directory (contains settings.json)
$DATA_DIR = "C:\some\folder\data"     # Path to dev data directory (contains static/ and provider folders)

# On first start, visit the UI in your browser to choose an auth mode.
# To skip setup for dev, add "auth": { "mode": "disabled" } to your settings.json.

# This value usually does not need to be changed
$STATIC_DIR = (Resolve-Path ".\frontend\dist").Path # Path to frontend build output

Write-Host "Building frontend..."
Push-Location frontend
npm run build
Pop-Location

Write-Host "Building backend..."
Push-Location backend
go build -o pwsafe-service.exe cmd/pwsafe-service/main.go

Write-Host "Stopping any running instance..."
Get-Process -Name "pwsafe-service" -ErrorAction SilentlyContinue | Stop-Process -Force

Write-Host "Starting pwsafe-service..."
$env:PWSAFE_CONFIG_DIR = $CONFIG_DIR
$env:PWSAFE_DATA_DIR = $DATA_DIR
$env:PWSAFE_STATIC_DIR = $STATIC_DIR
try {
    & .\pwsafe-service.exe
} finally {
    Pop-Location
}
